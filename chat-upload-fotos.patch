+      const nomeEl = document.createElement("div");
+      nomeEl.className = "nome";
+      nomeEl.textContent = data.nome === meuNome ? "Você" : (data.nome || "Anônimo");
+      div.appendChild(nomeEl);
+
+      if (ehImagem) {

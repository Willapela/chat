-        <div class="nome">${data.nome === meuNome ? "Você" : data.nome}</div>
-        <div>${escapeHtml(data.texto)}</div>
-        <div class="hora">${data.hora}</div>
-      `;
+      const ehImagem = data.tipo === "imagem" && typeof data.imagem === "string";
